---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => post.data.published !== false);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const postBody = post.body ?? "";
const plainBody = postBody
	.replace(/<script[\s\S]*?<\/script>/gi, "")
	.replace(/```[\s\S]*?```/g, "")
	.replace(/[#>*_`[\]()-]/g, " ")
	.replace(/\s+/g, " ")
	.trim();
const wordCount = plainBody ? plainBody.split(" ").length : 0;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 220));
const hasFaq = /^##\s+Questions fréquentes\b/mi.test(postBody);

const allPosts = (await getCollection("blog")).filter((p) => p.data.published !== false);
const postTags = new Set(post.data.tags ?? []);

const relatedPosts = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => {
		const shared = (p.data.tags ?? []).filter((tag) => postTags.has(tag)).length;
		return { post: p, shared, date: p.data.pubDate.valueOf() };
	})
	.sort((a, b) => b.shared - a.shared || b.date - a.date)
	.slice(0, 3)
	.map(({ post: related }) => related);
---

<BlogPost
	{...post.data}
	blogPost={true}
	readingTimeMinutes={readingTimeMinutes}
	hasFaq={hasFaq}
	relatedPosts={relatedPosts}
>
	<Content />
</BlogPost>
