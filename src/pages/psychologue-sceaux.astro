---
import { Picture } from "astro:assets";
import { ChevronDown } from "lucide";
import Layout from "../layouts/BlogPost.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DoctolibBookingLink from "../components/DoctolibBookingLink.astro";
import AuthorCard from "../components/AuthorCard.astro";
import BookingFab from "../components/BookingFab.astro";
import LucideIcon from "../components/LucideIcon.astro";
import {
  BOOKING_FOR_EXISTING_PATIENTS_ONLY,
  BOOKING_SENTENCE,
  CONSULTATION_AVAILABILITY,
} from "../data/consultation-availability";
import rueHoudanSceaux from "../assets/locations/rue-houdan-sceaux.jpg";
import cabinetBureau from "../assets/cabinet-1.webp";
import cabinetSalon from "../assets/cabinet-2.webp";
import { buttonClasses } from "../components/ui/button";
import {
  CABINET_ADDRESS_LINE,
  DOCTOLIB_PROFILE_URL,
  GOOGLE_MAPS_CABINET_URL,
  GOOGLE_MAPS_EMBED_URL,
  SERVED_CITIES_LABEL,
  OPENING_APPOINTMENT_NOTE,
  OPENING_WEEKDAYS_HOURS,
  OPENING_WEEKDAYS_LABEL,
  OPENING_FRIDAY_LABEL,
  OPENING_FRIDAY_HOURS,
  OPENING_SATURDAY_LABEL,
  OPENING_SATURDAY_HOURS,
} from "../consts";

const title = "Psychologue à Sceaux";
/** Title ≤ 60 car. — requête principale « psychologue sceaux ». */
const seoTitle = "Psychologue Sceaux (92330) | Nicolas Devaux";
const description =
  "Psychologue à Sceaux (92330), approche intégrative (TCC, thérapies brèves) : cabinet rue Houdan, proche RER Robinson. Adultes, adolescents, couples.";
/** Accroche visible du hero : la meta description reste réservée aux moteurs de recherche. */
const lede = "Un cabinet calme au cœur de Sceaux, à quelques minutes à pied des gares RER B Robinson et Sceaux.";

const isProd = import.meta.env.PROD;

/** Questions affichées en accordéon ; le JSON-LD est construit à partir de la même liste. */
const faqItems = [
  {
    question: "Comment prendre rendez-vous avec un psychologue à Sceaux ?",
    answer: `${OPENING_APPOINTMENT_NOTE} ${BOOKING_SENTENCE}`,
  },
  {
    question: "Les séances sont-elles remboursées ?",
    answer:
      "Les consultations de psychologie ne sont pas remboursées par la Sécurité sociale, mais de nombreuses mutuelles proposent une prise en charge partielle ou totale. Renseignez-vous auprès de la vôtre.",
  },
  {
    question: "Combien de séances sont nécessaires ?",
    answer:
      "La durée varie selon vos besoins et vos objectifs. Certaines difficultés peuvent être résolues en quelques séances, d'autres nécessitent un accompagnement plus long. Nous évaluons régulièrement l'évolution et ajustons ensemble le rythme des consultations.",
  },
  {
    question: "Y a-t-il un psychologue à Sceaux pour le Plessis-Robinson et les communes voisines ?",
    answer: `Oui. Le cabinet accueille notamment des patients venant de ${SERVED_CITIES_LABEL}. Des consultations en visioconférence sont aussi possibles si vous ne pouvez pas vous déplacer.`,
  },
  {
    question: "Ce que je dis en séance reste-t-il confidentiel ?",
    answer:
      "Oui. Les informations échangées dans le cadre des consultations sont protégées par le secret professionnel, au cabinet comme en visioconférence.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};

const secondaryCtaClasses = buttonClasses({
  variant: "secondary",
  size: "lg",
  className: "w-full justify-center sm:w-auto",
});
---

<Layout
  title={title}
  seoTitle={seoTitle}
  description={description}
  lede={lede}
  pubDate={new Date("May 24 2026")}
  showDate={false}
  eyebrow="Sceaux · Hauts-de-Seine"
  wideContent
  heroImage={rueHoudanSceaux}
  heroAlt="Rue Houdan, rue piétonne du centre-ville de Sceaux"
  heroCredit="Photo : Chabe01, Wikimedia Commons"
  heroCreditUrl="https://commons.wikimedia.org/wiki/File:Rue_Houdan_-_Sceaux_(FR92)_-_2023-03-19_-_6.jpg"
>
  {isProd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="grid gap-12 lg:grid-cols-[minmax(0,38rem)_minmax(17rem,1fr)] lg:gap-x-16 xl:gap-x-24">
    <header class="space-y-6 lg:col-start-1 lg:row-start-1">
      <p class="typo-body-lg text-ink-secondary">
        Je suis <a href="/nicolas-devaux-psychologue/" class="text-link">Nicolas Devaux</a>, psychologue clinicien. Je
        reçois les adultes, les adolescents et les couples au {CABINET_ADDRESS_LINE}, ainsi qu'en visioconférence
        selon la situation.
      </p>
      {BOOKING_FOR_EXISTING_PATIENTS_ONLY && !CONSULTATION_AVAILABILITY.isFull && (
        <p><a href="#pratique-heading" class="text-link">Comment demander un premier rendez-vous</a></p>
      )}
      <AuthorCard />
    </header>

    <aside class="lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-labelledby="coordonnees-heading">
      <div
        class="rounded-xl border border-border-subtle bg-surface-muted/60 px-5 py-6 sm:px-6 lg:sticky lg:top-28"
      >
        <h2 id="coordonnees-heading" class="font-display typo-display-md mt-0! mb-5! text-ink-primary">
          Le cabinet en bref
        </h2>
        <dl class="grid gap-4 font-ui text-sm text-ink-secondary sm:grid-cols-2 lg:grid-cols-1">
          <div>
            <dt class="font-semibold text-ink-primary">Adresse</dt>
            <dd class="mt-1">
              <a href={GOOGLE_MAPS_CABINET_URL} target="_blank" rel="noopener noreferrer" class="text-link">
                {CABINET_ADDRESS_LINE}<span class="sr-only"> (itinéraire Google Maps, nouvel onglet)</span>
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-primary">Accès</dt>
            <dd class="mt-1">RER B Robinson ou Sceaux<br />Parking Penthièvre, rue Houdan</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-primary">Horaires</dt>
            <dd class="mt-1 tabular-nums">
              {OPENING_WEEKDAYS_LABEL} : {OPENING_WEEKDAYS_HOURS}<br />
              {OPENING_FRIDAY_LABEL} : {OPENING_FRIDAY_HOURS}<br />
              {OPENING_SATURDAY_LABEL} : {OPENING_SATURDAY_HOURS.toLowerCase()}<br />
              Mercredi et jeudi : fermé
            </dd>
            <dd class="mt-2 text-ink-primary">{OPENING_APPOINTMENT_NOTE}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-primary">Tarifs</dt>
            <dd class="mt-1 tabular-nums">
              Individuelle : 80 € (45 min)<br />
              MOSAIC : 90 € (1 h)<br />
              Couple : 110 € (1 h)
            </dd>
            <dd class="mt-2">Non remboursé par la Sécurité sociale ; certaines mutuelles prennent en charge.</dd>
          </div>
        </dl>
        <div class="mt-6" data-booking-fab-hide>
          <DoctolibBookingLink location="Psychologue Sceaux encadre" size="lg" fullWidth class="justify-center">
            Prendre rendez-vous
          </DoctolibBookingLink>
        </div>
        <p class="mt-3 text-center font-ui text-xs text-ink-secondary">{BOOKING_SENTENCE}</p>
      </div>
    </aside>

    <div class="min-w-0 space-y-16 lg:col-start-1 lg:row-start-2">
      <section class="space-y-4" aria-labelledby="difficultes-heading">
        <SectionHeading id="difficultes-heading" title="Les difficultés que j'accompagne" />
        <ul>
          <li>
            <strong>Anxiété, stress et ruminations</strong>, avec la{" "}
            <a href="/therapie-cognitive-et-comportementale/" class="text-link">thérapie cognitive et comportementale</a>{" "}
            et des outils concrets à mettre en pratique entre les séances.
          </li>
          <li>
            <strong>Insomnie et troubles du sommeil</strong>, notamment avec la{" "}
            <a href="/blog/tcc-insomnie/" class="text-link">TCC de l'insomnie</a>.
          </li>
          <li>
            <strong>Souvenirs douloureux et vécus traumatiques</strong>, avec la{" "}
            <a href="/therapie-mosaic/" class="text-link">thérapie MOSAIC</a>.
          </li>
          <li>
            <strong>Conflits, crises et difficultés de communication dans le couple</strong>, en{" "}
            <a href="/therapie-couple/" class="text-link">thérapie de couple</a>.
          </li>
        </ul>
        <p>
          Plus largement, je propose une <a href="/psychotherapie/" class="text-link">psychothérapie individuelle</a>{" "}
          adaptée à votre situation, à votre rythme et à vos objectifs. Mon approche est intégrative : les thérapies
          cognitives et comportementales, y compris celles de{" "}
          <a href="/tcc-troisieme-vague/" class="text-link">troisième vague</a>, associées aux thérapies brèves et
          solutionnistes, selon ce dont vous avez besoin.
        </p>
      </section>

      <section class="space-y-5" aria-labelledby="cabinet-heading">
        <SectionHeading id="cabinet-heading" title="Le cabinet de la rue Houdan" />
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <Picture
            src={cabinetBureau}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[360, 540, 720]}
            sizes="(max-width: 1023px) 50vw, 19rem"
            alt="Le bureau de consultation : des fauteuils face à face, une bibliothèque et une fenêtre"
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: "block overflow-hidden rounded-xl" }}
            class="block aspect-4/3 h-auto w-full object-cover"
          />
          <Picture
            src={cabinetSalon}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[360, 540, 720]}
            sizes="(max-width: 1023px) 50vw, 19rem"
            alt="Une autre pièce du cabinet, avec un canapé et deux fauteuils bleus"
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: "block overflow-hidden rounded-xl" }}
            class="block aspect-4/3 h-auto w-full object-cover"
          />
        </div>
        <p>
          Un espace simple et calme, pensé pour échanger en toute confidentialité : les informations partagées en
          consultation sont protégées par le secret professionnel.
        </p>
      </section>

      <section class="space-y-4" aria-labelledby="acces-heading">
        <SectionHeading id="acces-heading" title="Venir au cabinet" />
        <ul>
          <li><strong>En RER B :</strong> gares Robinson ou Sceaux (ligne Paris – Robinson).</li>
          <li><strong>En voiture :</strong> parking Penthièvre, sur la même rue.</li>
          <li><strong>À pied :</strong> la rue Houdan est la rue piétonne du centre-ville.</li>
          <li><strong>Accessibilité :</strong> le cabinet se trouve au deuxième étage, sans ascenseur.</li>
        </ul>
        <div class="overflow-hidden rounded-xl border border-border-subtle bg-surface-muted">
          <iframe
            src={GOOGLE_MAPS_EMBED_URL}
            class="min-h-[280px] w-full border-0 md:min-h-[360px]"
            title={`Carte du cabinet, ${CABINET_ADDRESS_LINE}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <a href={GOOGLE_MAPS_CABINET_URL} target="_blank" rel="noopener noreferrer" class={secondaryCtaClasses}>
          Voir l'itinéraire<span class="sr-only"> (Google Maps, nouvel onglet)</span>
        </a>
      </section>

      <section class="space-y-4" aria-labelledby="pratique-heading">
        <SectionHeading id="pratique-heading" title="Votre premier rendez-vous" />
        {BOOKING_FOR_EXISTING_PATIENTS_ONLY && !CONSULTATION_AVAILABILITY.isFull && (
          <p>
            Pour une première demande, vous trouverez les coordonnées du cabinet sur
            {" "}<a href={DOCTOLIB_PROFILE_URL} class="text-link">mon profil Doctolib</a>.
          </p>
        )}
        <p>
          Les premières séances permettent de clarifier votre demande, de comprendre ce que vous traversez et de
          définir ensemble le cadre de travail le plus adapté. Le suivi est ajusté à vos besoins, à vos objectifs et à
          votre rythme : il peut s'agir d'un travail bref et ciblé ou d'un accompagnement plus approfondi.
        </p>
        <p>
          Les séances individuelles durent 45 minutes ; les séances de couple et les séances MOSAIC durent 1 heure.
          Elles ne sont pas remboursées par la Sécurité sociale, mais de nombreuses mutuelles proposent une prise en
          charge partielle ou totale : renseignez-vous auprès de la vôtre. Le détail est sur la page{" "}
          <a href="/tarifs/" class="text-link">Tarifs</a>.
        </p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          <div class="lg:hidden" data-booking-fab-hide>
            <DoctolibBookingLink location="Psychologue Sceaux pratique" size="lg" class="w-full justify-center sm:w-auto">
              Prendre rendez-vous
            </DoctolibBookingLink>
          </div>
          <a href="/consulter/" class={secondaryCtaClasses}>Préparer votre première consultation</a>
        </div>
      </section>

      <section class="space-y-4" aria-labelledby="faq-heading">
        <SectionHeading id="faq-heading" title="Questions fréquentes" />
        <div class="border-t border-border-subtle">
          {
            faqItems.map(({ question, answer }) => (
              <details class="group border-b border-border-subtle">
                <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 py-4 font-ui font-semibold leading-snug text-ink-primary transition-colors hover:text-brand [&::-webkit-details-marker]:hidden">
                  <span>{question}</span>
                  <LucideIcon
                    icon={ChevronDown}
                    size="lg"
                    class="mt-0.5 shrink-0 text-ink-secondary transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
                  />
                </summary>
                <p class="pb-5 text-ink-secondary">{answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <div class="lg:hidden">
    <BookingFab />
  </div>
</Layout>
