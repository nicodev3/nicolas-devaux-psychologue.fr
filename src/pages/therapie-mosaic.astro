---
import Layout from "../layouts/BlogPost.astro";
import { Image, Picture } from "astro:assets";
import MosaicImage from "../assets/emdr-therapie-mosaic.webp";
import MosaicSchemaImage from "../assets/blog/infographie-mosaic.webp";
import EmotionRegionsImage from "../assets/blog/cerveau-regions-emotion-fr.webp";
import MosaicFormationImage from "../assets/logo-mosaic.svg";
import MosaicPractitionerPdf from "../assets/Ici-votre-praticien-MOSAIC.pdf?url";
import modalitiesImage from "../assets/interior-modalities-stones.jpg";
import DoctolibBookingLink from "../components/DoctolibBookingLink.astro";
import InteriorQuote from "../components/InteriorQuote.astro";
import LucideIcon from "../components/LucideIcon.astro";
import { buttonClasses } from "../components/ui/button";
import { NEARBY_CITIES } from "../consts";
import { Brain, Leaf, MapPin, Video } from "lucide";

const isProd = import.meta.env.PROD;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Qu'est-ce que la thérapie MOSAIC ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "MOSAIC signifie Mouvements Oculaires et Stimulations Alternées pour l'Intégration Cérébrale. C'est une approche dérivée de l'EMDR, qui utilise les stimulations bilatérales alternées avec une logique orientée vers les solutions et l'apaisement plutôt que vers l'exposition prolongée au souvenir douloureux. Je suis certifié à la formation MOSAIC de référence par Stéphanie Khalfa, fondatrice de la méthode.",
      },
    },
    {
      "@type": "Question",
      name: "Combien coûte une séance MOSAIC ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Une séance MOSAIC dure 1 heure et coûte 90 €. Le détail des tarifs est disponible sur la page Tarifs du site.",
      },
    },
    {
      "@type": "Question",
      name: "Peut-on faire une séance MOSAIC en ligne ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Oui, selon la situation. Les séances ont lieu au cabinet à Sceaux, et des consultations en visioconférence peuvent être proposées après évaluation, notamment si vous êtes éloigné du cabinet.",
      },
    },
    {
      "@type": "Question",
      name: "Combien de séances faut-il ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Cela dépend de la nature de la difficulté, de son ancienneté, de vos ressources actuelles et de votre situation globale. L'évaluation initiale permet d'estimer un cadre de travail, sans promesse de résultat en un nombre de séances donné.",
      },
    },
    {
      "@type": "Question",
      name: "Faut-il revivre le traumatisme pendant les séances ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non, pas au sens d'une exposition prolongée et détaillée. Le travail porte d'abord sur la situation limitante telle qu'elle est vécue aujourd'hui, puis sur l'état interne désiré, sans nécessiter un récit exhaustif de l'événement.",
      },
    },
    {
      "@type": "Question",
      name: "Quelle différence entre l'EMDR et MOSAIC ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Les deux approches partagent l'usage des stimulations bilatérales alternées. L'EMDR travaille classiquement avec le souvenir traumatique cible, tandis que MOSAIC met davantage l'accent sur l'expérience corporelle de la solution et les ressources de la personne.",
      },
    },
  ],
};

const mosaicCtaSecondary = buttonClasses({
  variant: "secondary",
  size: "lg",
  className: "w-full justify-center sm:w-auto",
});
---

<Layout
  title="Thérapie MOSAIC"
  seoTitle="Thérapie MOSAIC à Sceaux"
  description="Une approche neuroscientifique pour libérer les traumatismes par le mouvement et la reconnexion aux ressources internes."
  pubDate={new Date("March 07 2026")}
  showDate={false}
  eyebrow="Approches thérapeutiques"
  wideContent
  heroAlt="Espace de consultation calme — thérapie MOSAIC à Sceaux"
>
  {isProd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <!-- Approche détaillée — grille Stitch 5 / 7 -->
  <section class="py-4 md:py-8" aria-labelledby="mosaic-method-heading">
    <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <div class="md:sticky md:top-28">
          <h2 id="mosaic-method-heading" class="font-display typo-display-lg mb-6 text-ink-primary">
            Qu'est-ce que la méthode MOSAIC ?
          </h2>
          <div class="mb-8 h-px w-16 bg-brand/30" aria-hidden="true"></div>
          <p class="typo-body italic text-ink-secondary">
            « La thérapie MOSAIC, une approche dérivée de l'EMDR, aide à retraiter les souvenirs
            douloureux et les vécus traumatiques. »
          </p>
        </div>
      </div>

      <div class="space-y-14 md:col-span-7 md:space-y-16">
        <div class="space-y-5">
          <h3 class="font-display typo-display-md text-ink-primary">Une évolution de l'EMDR</h3>
          <p>
            La thérapie{" "}
            <strong>
              <a
                href="https://www.therapiemosaic.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-link">MOSAIC</a
              >
            </strong>{" "}
            (Mouvements Oculaires et Stimulations Alternées pour l'Intégration Cérébrale) se
            distingue par une approche centrée sur les solutions et les ressources déjà présentes
            en vous. Contrairement aux approches classiques qui peuvent raviver la douleur, MOSAIC
            privilégie la création de nouveaux réseaux neuronaux liés au bien-être et à la sécurité.
          </p>
          <p>
            Elle fait partie des approches spécifiques que je peux proposer au cabinet lorsque la
            difficulté est liée à une mémoire douloureuse, à un vécu traumatique ou à une réaction
            émotionnelle qui reste trop intense malgré le temps écoulé. Je suis certifié à la
            thérapie MOSAIC de référence par Stéphanie Khalfa, fondatrice de la méthode.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
          <div class="bg-surface-footer p-8 md:p-10">
            <LucideIcon icon={Brain} class="mb-4 !h-8 !w-8 text-ink-primary" />
            <h4 class="typo-eyebrow mb-4 tracking-widest text-ink-primary">Neuroplasticité</h4>
            <p class="m-0 text-sm leading-relaxed text-ink-secondary">
              Utilisation des stimulations bilatérales pour favoriser le retraitement cérébral des
              informations bloquées.
            </p>
          </div>
          <div class="border border-border-strong/40 bg-surface-muted p-8 md:p-10">
            <LucideIcon icon={Leaf} class="mb-4 !h-8 !w-8 text-ink-primary" />
            <h4 class="typo-eyebrow mb-4 tracking-widest text-ink-primary">Ressources</h4>
            <p class="m-0 text-sm leading-relaxed text-ink-secondary">
              Focus sur le développement de vos capacités d'auto-apaisement et de résilience
              immédiate.
            </p>
          </div>
        </div>

        <div class="space-y-5">
          <h3 class="font-display typo-display-md text-ink-primary">Accompagnement flexible</h3>
          <p>
            La thérapie s'adapte à votre rythme et à vos contraintes de vie. Que vous soyez en
            recherche d'une résolution ponctuelle ou d'un travail de fond, le cadre reste sécurisant
            et professionnel — au cabinet à Sceaux ou en visioconférence selon la situation.
          </p>
          <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:gap-8">
            <div class="flex items-center gap-3">
              <LucideIcon icon={MapPin} class="text-ink-primary" />
              <span class="font-ui text-sm font-medium text-ink-secondary">Cabinet à Sceaux</span>
            </div>
            <div class="flex items-center gap-3">
              <LucideIcon icon={Video} class="text-ink-primary" />
              <span class="font-ui text-sm font-medium text-ink-secondary">Visioconférence</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <InteriorQuote quote="Libérer le corps pour apaiser l'esprit." />

  <!-- Modalités -->
  <section class="py-16 md:py-[7.5rem]" aria-labelledby="mosaic-modalities-heading">
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-20">
      <div class="order-2 md:order-1">
        <div class="aspect-4/5 overflow-hidden bg-surface-muted">
          <Picture
            src={modalitiesImage}
            alt="Équilibre et apaisement — image symbolique des séances MOSAIC"
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[480, 720, 960]}
            sizes="(max-width: 767px) 100vw, 50vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover grayscale transition-all duration-700 hover:grayscale-0"
          />
        </div>
      </div>

      <div class="order-1 space-y-8 md:order-2 md:space-y-10">
        <div>
          <h2 id="mosaic-modalities-heading" class="font-display typo-display-lg mb-6 text-ink-primary">
            Modalités des séances
          </h2>
          <p class="text-ink-secondary">
            Séances au cabinet à Sceaux ou en visioconférence, selon la situation. Chaque rencontre
            est un espace neutre, confidentiel et bienveillant dédié à votre cheminement personnel.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-end justify-between border-b border-border-strong/30 pb-4">
            <div>
              <h3 class="typo-eyebrow mb-1 text-ink-primary">Séance MOSAIC</h3>
              <p class="m-0 text-xs uppercase tracking-widest text-ink-tertiary">Durée : 60 minutes</p>
            </div>
            <span class="font-display typo-display-md text-ink-primary">90&nbsp;€</span>
          </div>
          <div class="flex items-end justify-between border-b border-border-strong/30 pb-4">
            <div>
              <h3 class="typo-eyebrow mb-1 text-ink-primary">Consultation individuelle</h3>
              <p class="m-0 text-xs uppercase tracking-widest text-ink-tertiary">Durée : 45 minutes</p>
            </div>
            <span class="font-display typo-display-md text-ink-primary">80&nbsp;€</span>
          </div>
        </div>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          <DoctolibBookingLink
            location="Therapie MOSAIC consultations"
            size="lg"
            class="w-full justify-center uppercase tracking-[0.15em] sm:w-auto"
          >
            Prendre rendez-vous
          </DoctolibBookingLink>
          <a href="/consulter/" class={mosaicCtaSecondary}>
            Savoir si cette approche est adaptée
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenu approfondi -->
  <section class="space-y-12 border-t border-border-subtle pt-16 md:space-y-14 md:pt-20" aria-label="En savoir plus">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <h2 class="font-display typo-display-md text-ink-primary">Dans quels cas cette approche peut être utile ?</h2>
      </div>
      <div class="md:col-span-8 space-y-4">
        <p>
          La thérapie MOSAIC peut être indiquée lorsqu'un événement ou un souvenir reste associé à
          une détresse importante, à un sentiment de blocage ou à une hyperréactivité émotionnelle.
        </p>
        <ul>
          <li>Souvenirs douloureux ou traumatiques.</li>
          <li>Stress persistant après un événement difficile.</li>
          <li>Réactions émotionnelles envahissantes ou disproportionnées.</li>
          <li>Blocages qui se répètent malgré un travail de compréhension déjà engagé.</li>
        </ul>
        <p>L'indication se décide toujours au cas par cas, après évaluation clinique.</p>
      </div>
    </div>

    <div class="my-2">
      <Picture
        src={MosaicImage}
        alt="Thérapie MOSAIC"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="mx-auto w-full max-w-3xl"
      />
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <h2 class="font-display typo-display-md text-ink-primary">Différence entre l'EMDR et MOSAIC</h2>
      </div>
      <div class="md:col-span-8 space-y-4">
        <p>
          L'EMDR et MOSAIC partagent l'usage des stimulations bilatérales alternées. La différence
          principale tient au point d'entrée thérapeutique.
        </p>
        <ul>
          <li>L'EMDR travaille classiquement avec le souvenir traumatique cible.</li>
          <li>MOSAIC met davantage l'accent sur l'expérience corporelle de la solution.</li>
        </ul>
        <p>
          En pratique, de nombreuses personnes décrivent MOSAIC comme une approche plus douce, tout
          en restant active et structurée. Voir aussi le comparatif{" "}
          <a href="/blog/therapie-mosaic/" class="text-link">MOSAIC ou EMDR</a>.
        </p>
      </div>
    </div>

    <div class="my-2">
      <Image src={MosaicSchemaImage} alt="Schéma simplifié de la thérapie MOSAIC" class="w-full max-w-3xl" />
      <p class="mt-2 text-sm text-ink-tertiary">
        Illustration : modèle simplifié du fonctionnement de la thérapie MOSAIC.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <h2 class="font-display typo-display-md text-ink-primary">Comment se déroule l'accompagnement ?</h2>
      </div>
      <div class="md:col-span-8 space-y-4">
        <p>
          Les premières séances permettent de comprendre votre demande, de vérifier si cette
          approche est adaptée et de définir un cadre clair. Le travail thérapeutique se fait ensuite
          de manière progressive et structurée.
        </p>
        <ol>
          <li>
            <strong>Entretien MOSAIC :</strong> définition de la situation limitante, des objectifs
            et de l'état interne désiré.
          </li>
          <li>
            <strong>Boucle de reconnexion :</strong> renforcement progressif de l'état recherché avec
            stimulations bilatérales alternées.
          </li>
          <li>
            <strong>Projection des bénéfices :</strong> travail sur les changements concrets attendus
            dans le quotidien.
          </li>
          <li>
            <strong>Intégration :</strong> débriefing et exercice simple entre les séances pour
            stabiliser le travail.
          </li>
        </ol>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <h2 class="font-display typo-display-md text-ink-primary">Ce que disent les neurosciences</h2>
      </div>
      <div class="md:col-span-8 space-y-4">
        <p>
          Les recherches sur le psychotraumatisme et l'EMDR montrent l'implication de réseaux
          cérébraux liés à la peur, à la mémoire contextuelle, à la régulation émotionnelle et à la
          conscience de soi.
        </p>
        <ul>
          <li>Amygdale : détection de la menace.</li>
          <li>Hippocampe : mémoire contextuelle.</li>
          <li>Cortex préfrontal : régulation émotionnelle.</li>
          <li>Insula, précuneus, cingulaire : intégration multisensorielle et conscience de soi.</li>
        </ul>
        <p>
          Les stimulations bilatérales alternées semblent moduler ces réseaux et favoriser une
          reconsolidation de la mémoire traumatique avec moins de charge émotionnelle.
        </p>
        <Picture
          src={EmotionRegionsImage}
          alt="Régions cérébrales impliquées dans la régulation émotionnelle"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="lazy"
          decoding="async"
          class="mt-4"
        />
        <p class="mt-2 text-sm text-ink-tertiary">
          Illustration : principales régions cérébrales impliquées dans la régulation émotionnelle.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <h2 class="font-display typo-display-md text-ink-primary">Cadre et efficacité</h2>
      </div>
      <div class="md:col-span-8 space-y-4">
        <ul>
          <li>
            L'EMDR est une thérapie validée scientifiquement pour le trouble de stress
            post-traumatique.
          </li>
          <li>
            MOSAIC est une approche plus récente. Son corpus de recherche propre reste moins
            développé que celui de l'EMDR et ne permet pas de leur attribuer aujourd'hui le même
            niveau de validation.
          </li>
        </ul>
        <p>
          Je suis certifié à la <strong>thérapie MOSAIC de référence</strong> par Stéphanie Khalfa,
          chercheuse en neurosciences et co-fondatrice de la méthode. Cette certification est
          délivrée directement par l'organisme MOSAIC, indépendamment d'EMDR France.
        </p>
        <p>
          Selon votre situation, il peut être plus pertinent de commencer par une{" "}
          <a href="/psychotherapie/" class="text-link">psychothérapie</a> ou par une approche de{" "}
          <a href="/tcc-troisieme-vague/" class="text-link">TCC de 3e vague</a>.
        </p>
        <p>
          Le cabinet est accessible pour les personnes habitant Sceaux et les villes voisines comme{" "}
          {NEARBY_CITIES.replace(" et ", ", ")} ou Le Plessis-Robinson.
        </p>
      </div>
    </div>

    <div id="faq" class="space-y-6 border-t border-border-subtle pt-12 md:pt-16">
      <h2 class="font-display typo-display-lg text-ink-primary">Questions fréquentes</h2>

      <h3 class="font-display typo-display-md text-ink-primary">La thérapie MOSAIC est-elle reconnue ?</h3>
      <p>
        MOSAIC est enseignée et pratiquée par des professionnels formés, mais elle est plus récente
        que l'EMDR et dispose d'un corpus de recherche propre moins développé. Elle ne doit donc pas
        être présentée comme bénéficiant aujourd'hui du même niveau de validation scientifique.
      </p>

      <h3 class="font-display typo-display-md text-ink-primary">Combien coûte une séance MOSAIC ?</h3>
      <p>
        Une séance dure 1 heure et coûte 90 €. Le détail des tarifs et des modalités de paiement est
        disponible sur la page <a href="/tarifs/" class="text-link">Tarifs</a>.
      </p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">Peut-on faire une séance MOSAIC en ligne ?</h3>
      <p>
        Oui, selon la situation. Les séances ont lieu au cabinet à Sceaux, et des séances en{" "}
        <a href="/psychologue-en-ligne/" class="text-link">visioconférence</a> peuvent être proposées
        après évaluation, notamment si vous êtes éloigné du cabinet.
      </p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">Combien de séances faut-il ?</h3>
      <p>
        Cela dépend de la nature du trauma, de son ancienneté, de vos ressources actuelles et de
        votre situation globale. L'évaluation initiale permet d'estimer un cadre de travail.
      </p>

      <h3 class="font-display typo-display-md text-ink-primary">
        Peut-on faire MOSAIC si on a déjà suivi une thérapie EMDR ?
      </h3>
      <p>Oui. Les deux approches peuvent être complémentaires selon vos besoins.</p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">
        La thérapie MOSAIC est-elle douloureuse ou éprouvante ?
      </h3>
      <p>
        MOSAIC est conçue pour éviter l'exposition prolongée à la douleur du souvenir. L'approche
        travaille davantage sur l'état interne recherché et les ressources que sur le récit détaillé
        du traumatisme. La plupart des personnes décrivent les séances comme exigeantes mais
        soutenables, et souvent apaisantes en fin de session. Si une séance est trop intense, le
        rythme peut être ajusté.
      </p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">
        Faut-il revivre le traumatisme pendant les séances ?
      </h3>
      <p>
        Non, pas au sens d'une exposition prolongée et détaillée. MOSAIC n'oblige pas à raconter
        l'intégralité de l'événement traumatique. Le travail porte d'abord sur la
        <em> situation limitante</em> telle qu'elle est vécue aujourd'hui, puis sur l'état interne
        désiré.
      </p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">
        MOSAIC convient-elle en cas d'anxiété sans traumatisme clairement identifié ?
      </h3>
      <p>
        Oui. MOSAIC ne se limite pas aux traumatismes au sens strict. Elle peut être utile lorsque
        des réactions émotionnelles restent disproportionnées ou envahissantes, même sans événement
        traumatique identifié. L'évaluation clinique préalable permet de déterminer si l'approche
        est indiquée.
      </p>

      <h3 class="font-display typo-display-md mt-5 text-ink-primary">
        La thérapie MOSAIC peut-elle être combinée avec d'autres approches ?
      </h3>
      <p>
        Oui. MOSAIC s'intègre dans une logique d'accompagnement intégratif. Selon votre situation,
        elle peut être proposée en complément d'une{" "}
        <a href="/psychotherapie/" class="text-link">psychothérapie</a>, d'un suivi en{" "}
        <a href="/therapie-acceptation-et-engagement/" class="text-link">ACT</a>, ou d'une{" "}
        <a href="/therapie-couple/" class="text-link">thérapie de couple</a>.
      </p>
    </div>

    <div class="border border-border-strong bg-surface-footer/60 p-6 md:p-8">
      <h2 class="font-display typo-display-md mb-4 text-ink-primary">Pour aller plus loin</h2>
      <p class="mb-3">Pour préparer votre démarche, vous pouvez aussi consulter :</p>
      <ul class="mb-4 list-inside list-disc space-y-2">
        <li>
          <a href="/psychotherapie/" class="text-link">Approches thérapeutiques au cabinet</a>
        </li>
        <li>
          <a href="/consulter/" class="text-link">Consulter un psychologue à Sceaux</a>
        </li>
        <li>
          <a href="/blog/pourquoi-consulter-psychologue/" class="text-link"
            >Pourquoi consulter un psychologue ?</a
          >
        </li>
        <li>
          <a href="/blog/therapie-mosaic/" class="text-link"
            >MOSAIC ou EMDR : quelles différences ?</a
          >
        </li>
      </ul>
      <p class="mb-3">Ressources complémentaires :</p>
      <ul class="mb-4 list-inside list-disc space-y-2">
        <li>
          <a
            href="https://www.therapiemosaic.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link">Site officiel therapiemosaic.com</a
          >
        </li>
        <li>
          <a
            href="https://www.therapiemosaic.com/formations/mosaic-de-reference-1759841379915"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link">Formation MOSAIC de référence</a
          >
        </li>
      </ul>
      <p class="mb-3">Document pratique :</p>
      <a
        href={MosaicPractitionerPdf}
