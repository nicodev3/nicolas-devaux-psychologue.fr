---
import { Sparkles, Users, Brain, Activity, Leaf, Video } from "lucide";
import SectionHeading from "./SectionHeading.astro";
import LucideIcon from "./LucideIcon.astro";
import { applyFrenchTypography } from "../utils/frenchTypography.js";

const featured = {
  url: "/therapie-mosaic/",
  title: "Thérapie MOSAIC",
  content:
    "La thérapie MOSAIC, une approche dérivée de l'EMDR, aide à retraiter les souvenirs douloureux et les vécus traumatiques. Séances au cabinet à Sceaux ou en visioconférence, selon la situation.",
  icon: Sparkles,
};

const couple = {
  url: "/therapie-couple/",
  title: "Thérapie de couple",
  content:
    "Des consultations de couple pour travailler les conflits répétés, les difficultés de communication, les crises et l'éloignement, en s'appuyant sur les approches ACT et IBCT.",
  icon: Users,
};

const cards = [
  {
    url: "/techniques-activation-conscience/",
    title: "Techniques d'activation de la conscience (TAC)",
    content:
      "Une approche guidée qui combine activation émotionnelle et conscience présente, utile lorsque la compréhension intellectuelle ne suffit pas à modifier les réactions automatiques.",
    icon: Brain,
  },
  {
    url: "/tcc-troisieme-vague/",
    title: "Thérapies cognitives et comportementales (TCC)",
    content:
      "Certaines approches TCC de 3e vague comme l'ACT et la CFT proposent des outils concrets pour travailler l'anxiété, les ruminations, le stress, l'autocritique ou l'évitement.",
    icon: Activity,
  },
  {
    url: "/meditation-pleine-conscience-sceaux/",
    title: "Groupes de pleine conscience",
    content:
      "Des ateliers en petit groupe pour apprendre à porter attention à ses pensées, apaiser le stress et se reconnecter à ses sensations corporelles, dans un cadre simple et guidé.",
    icon: Leaf,
  },
  {
    url: "/psychologue-en-ligne/",
    title: "Consultations en ligne",
    content:
      "Des consultations en visioconférence, dans le même cadre de confidentialité qu'au cabinet, pour les personnes éloignées de Sceaux ou qui préfèrent ce format.",
    icon: Video,
  },
] as const;
---

<section
  id="approches"
  class="relative left-1/2 w-screen -translate-x-1/2 bg-surface-muted py-16 md:py-[7.5rem]"
  aria-labelledby="approches-heading"
>
  <div class="mx-auto w-full max-w-[1140px] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
      <SectionHeading
        class="mb-4 md:mb-6 [&_.section-heading-group]:items-center"
        eyebrow="01 — Consultations"
        title="Des consultations et des approches adaptées à votre situation"
        id="approches-heading"
      />
      <p class="typo-body text-ink-secondary">
        Je propose plusieurs types de consultations : thérapie individuelle, thérapie MOSAIC, thérapie
        de couple, consultations en ligne et groupes de pleine conscience.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div
        class="group rounded-xl bg-surface-raised p-8 transition-all duration-500 hover:shadow-xl md:col-span-2 md:p-10"
      >
        <div class="flex h-full flex-col justify-between">
          <div>
            <LucideIcon icon={featured.icon} size="lg" class="mb-6 text-ink-primary" />
            <h3 class="font-display typo-display-md mb-4 text-ink-primary">
              {applyFrenchTypography(featured.title)}
            </h3>
            <p class="max-w-md text-ink-secondary">{featured.content}</p>
          </div>
          <a
            href={featured.url}
            class="mt-8 inline-flex items-center font-ui text-sm font-medium tracking-wide text-ink-primary transition-all group-hover:gap-2"
          >
            En savoir plus
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div
        class="group rounded-xl bg-surface-accent p-8 transition-all duration-500 hover:shadow-xl md:p-10"
      >
        <LucideIcon icon={couple.icon} size="lg" class="mb-6 text-ink-secondary" />
        <h3 class="font-display typo-display-md mb-4 text-ink-primary">
          {applyFrenchTypography(couple.title)}
        </h3>
        <p class="text-sm text-ink-secondary">{couple.content}</p>
        <a
          href={couple.url}
          class="mt-6 inline-flex items-center font-ui text-sm font-medium tracking-wide text-ink-primary transition-transform group-hover:translate-x-1"
        >
          En savoir plus →
        </a>
      </div>

      {
        cards.map((card) => (
          <a
            href={card.url}
            class="group rounded-xl bg-brand/5 p-8 no-underline transition-colors hover:bg-brand/10 md:p-10"
          >
            <LucideIcon icon={card.icon} size="lg" class="mb-4 text-ink-primary" />
            <h4 class="mb-2 font-ui text-sm font-bold uppercase tracking-wide text-ink-primary">
              {applyFrenchTypography(card.title)}
            </h4>
            <p class="text-sm text-ink-secondary">{card.content}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/psychotherapie/"
        class="border-b border-ink-primary font-ui text-sm font-medium tracking-wide text-ink-primary transition-opacity hover:opacity-70"
      >
        Toutes les approches
      </a>
    </div>
  </div>
</section>
