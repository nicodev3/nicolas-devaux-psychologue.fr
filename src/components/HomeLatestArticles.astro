---
import SectionHeading from "./SectionHeading.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatFrenchDate, toDateTime } from "../utils/formatDate";
import { applyFrenchTypography } from "../utils/frenchTypography.js";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);
---

<section
  class="relative left-1/2 w-screen -translate-x-1/2 bg-border-subtle/30 py-16 md:py-[7.5rem]"
  aria-labelledby="home-articles-heading"
>
  <div class="mx-auto w-full max-w-[1140px] px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col items-start justify-between gap-6 md:mb-12 md:flex-row md:items-end">
      <SectionHeading eyebrow="05 — Lecture" title="Derniers articles" id="home-articles-heading" />
      <a
        href="/blog/"
        class="border-b border-ink-primary font-ui text-sm font-medium tracking-wide text-ink-primary transition-opacity hover:opacity-70"
      >
        Voir tous les articles →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        latestPosts.map((post) => (
          <article class="group">
            <a href={`/blog/${post.id}/`} class="block no-underline">
              {post.data.heroImage && (
                <div class="mb-6 aspect-video overflow-hidden rounded-lg">
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.title}
                    width={640}
                    height={360}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <time
                class="font-ui text-xs font-semibold uppercase tracking-wider text-ink-tertiary"
                datetime={toDateTime(post.data.pubDate)}
              >
                {formatFrenchDate(post.data.pubDate)}
              </time>
              <h3 class="font-display mt-4 mb-0 text-[1.375rem] leading-tight text-ink-primary transition-opacity group-hover:opacity-70">
                {applyFrenchTypography(post.data.title)}
              </h3>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
