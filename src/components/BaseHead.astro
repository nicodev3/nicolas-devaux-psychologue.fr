---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_NAME } from "../consts";
import {
  buildLocalBusinessSchema,
  CABINET_SCHEMA_ID,
} from "../data/local-business-schema";
import { pathnameToOgSlug } from "../utils/pathname-to-og-slug";
import { applyFrenchTypography } from "../utils/frenchTypography.js";

interface Props {
	title: string;
	description: string;
	/** Surcharge du fichier `/og/{slug}.png` (cas rare). */
	ogImageSlug?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, ogImageSlug } = Astro.props;
const formattedTitle = applyFrenchTypography(title);
const formattedDescription = applyFrenchTypography(description);
const TITLE_BRAND = "Nicolas Devaux";
const pageTitle =
  formattedTitle.includes(SITE_NAME) || formattedTitle.includes(TITLE_BRAND)
    ? formattedTitle
    : `${formattedTitle} | ${TITLE_BRAND}`;
const siteBase = Astro.site ?? Astro.url.origin;
const ogSlug = ogImageSlug ?? pathnameToOgSlug(Astro.url.pathname);
const ogImagePath = `/og/${ogSlug}.png`;
const ogImageAbsolute = new URL(ogImagePath, siteBase).href;
const OG_RW = 1200;
const OG_RH = 630;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL;
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    buildLocalBusinessSchema(),
    {
      "@type": "WebSite",
      "@id": "https://nicolas-devaux-psychologue.fr/#website",
      url: "https://nicolas-devaux-psychologue.fr",
      name: "Nicolas Devaux — Psychologue clinicien",
      description:
        "Site officiel de Nicolas Devaux, psychologue clinicien (TCC, ACT, MOSAIC, pleine conscience).",
      publisher: { "@id": CABINET_SCHEMA_ID },
      inLanguage: ["fr-FR", "en-GB"],
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Polices : Inter Variable (axe opsz) et Source Serif 4 Variable via CSS bundlé -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={formattedDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={formattedDescription} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:width" content={String(OG_RW)} />
<meta property="og:image:height" content={String(OG_RH)} />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content="fr_FR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={formattedDescription} />
<meta name="twitter:image" content={ogImageAbsolute} />

<!-- Schema.org (prod). hasMap = GOOGLE_MAPS_CABINET_URL dans consts.ts (script is:inline). -->
{import.meta.env.PROD && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
)}

{umamiId && umamiUrl && (
  <>
    <script
      is:inline
      defer
      src={`${umamiUrl}/script.js`}
      data-website-id={umamiId}
    ></script>
    <script is:inline defer>
      document.addEventListener(
        "click",
        function (e) {
          if (e.defaultPrevented) return;
          if (e.button !== 0) return;
          if (e.ctrlKey || e.metaKey || e.shiftKey) return;
          var link = e.target.closest("a[data-track-doctolib]");
          if (!link || !link.href) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          var loc = link.getAttribute("data-track-location") || "";
          var href = link.href;
          var opened = false;
          function go() {
            if (opened) return;
            opened = true;
            window.open(href, "_blank", "noopener,noreferrer");
          }
          try {
            var p = window.umami && window.umami.track("Doctolib Click", loc ? { location: loc } : {});
            if (p && typeof p.then === "function") {
              p.then(go, go);
            } else {
              go();
            }
          } catch (err) {
            go();
          }
          setTimeout(go, 500);
        },
        true
      );

      document.addEventListener(
        "submit",
        function (e) {
          var form = e.target;
          if (!(form instanceof HTMLFormElement)) return;
          if (!form.matches("form[data-track-contact]")) return;
          var eventName = form.getAttribute("data-track-event") || "Contact Form Submit";
          var location = form.getAttribute("data-track-location") || "";
          try {
            window.umami &&
              window.umami.track(eventName, location ? { location: location } : {});
          } catch (err) {
            // Do not block form submission if tracking fails.
          }
        },
        true
      );
    </script>
  </>
)}

{import.meta.env.PROD && (
  <script
    is:inline
    async
    src="https://analytics.ahrefs.com/analytics.js"
    data-key="HjNHnvl6KtUSaCirHNzUFg"
  ></script>
)}
