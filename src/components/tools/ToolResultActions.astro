---
import { buttonClasses } from "../ui/button";

/**
 * Actions proposées une fois le test terminé : revenir sur ses réponses,
 * imprimer, copier la synthèse pour la partager avec son psychologue, ou tout
 * effacer. L'action destructrice reste la dernière et demande confirmation.
 */
const actionClass = buttonClasses({
  variant: "secondary",
  size: "sm",
  className: "gap-1.5 font-normal normal-case text-ink-secondary",
});
---

<div class="no-print flex shrink-0 flex-wrap gap-2">
  <button type="button" @click="editAnswers()" class={actionClass}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
    </svg>
    Modifier mes réponses
  </button>

  <button type="button" @click="copyResults()" class={actionClass}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="12" height="12" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span x-text="copyState === 'ok' ? 'Copié' : copyState === 'error' ? 'Copie impossible' : 'Copier'">Copier</span>
  </button>

  <button type="button" onclick="window.print()" class={actionClass}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M17 17h2a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2m2 4h6a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2Zm8-12V5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v4h10Z"
      ></path>
    </svg>
    Imprimer
  </button>

  <button
    type="button"
    @click="reset()"
    class={buttonClasses({
      variant: "secondary",
      size: "sm",
      className:
        "gap-1.5 border-danger bg-danger-surface font-normal normal-case text-danger hover:bg-border-subtle",
    })}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M4 4v5h.582m15.356 2A8.001 8.001 0 0 0 4.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 0 1-15.357-2m15.357 2H15"
      ></path>
    </svg>
    Recommencer
  </button>

  <p class="sr-only" role="status" x-text="copyState === 'ok' ? 'Synthèse copiée dans le presse-papiers.' : ''"></p>
</div>
