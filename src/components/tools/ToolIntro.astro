---
import SectionHeading from "../SectionHeading.astro";

/**
 * En-tête commun aux questionnaires : identité du test, ce qui attend la
 * personne (nombre de questions, durée, confidentialité), consignes et échelle
 * de réponse. Le H1 de la page reste celui du hero — ici on démarre en H2.
 */
interface Props {
  /** Nom du test tel qu'affiché en tête de questionnaire. */
  title: string;
  /** Référence complète (nom d'origine, version, traduction). */
  subtitle: string;
  questions: number;
  /** Durée indicative, ex. « ~5 minutes ». */
  duration: string;
  scale: readonly (readonly [number, string])[];
}

const { title, subtitle, questions, duration, scale } = Astro.props;

const meta = [`${questions} questions`, duration, "Réponses privées"];
---

<header class="mb-10 md:mb-12" x-show="!submitted">
  <p class="typo-eyebrow mb-3 md:mb-4">Le questionnaire</p>
  <h2 class="font-display typo-h1 mb-2 text-pretty text-ink-primary md:mb-3">{title}</h2>
  <p class="mb-5 text-sm text-ink-tertiary">{subtitle}</p>

  <ul class="mb-6 flex list-none flex-wrap gap-2 p-0">
    {
      meta.map((item) => (
        <li class="font-ui m-0 rounded-full bg-secondary px-3 py-1 text-xs font-medium text-ink-secondary">
          {item}
        </li>
      ))
    }
  </ul>

  <div class="rounded-xl border border-border-subtle bg-secondary/40 p-5 md:p-6">
    <SectionHeading class="mb-4" eyebrow="01 — Consignes" title="Instructions" />
    <div class="mb-5 space-y-3 text-sm leading-relaxed text-ink-secondary">
      <slot />
    </div>
    <p class="font-ui mb-2 text-xs font-medium uppercase tracking-wider text-ink-tertiary">Échelle de réponse</p>
    <ul class="grid list-none grid-cols-1 gap-2 p-0 text-sm sm:grid-cols-2">
      {
        scale.map(([value, label]) => (
          <li class="m-0 flex items-start gap-2.5">
            <span class="font-ui flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border-strong bg-surface-raised text-xs font-medium text-tertiary">
              {value}
            </span>
            <span class="leading-snug text-ink-secondary">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-4 flex items-start gap-1.5 text-xs text-ink-tertiary">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="mt-0.5 h-4 w-4 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="11" width="18" height="10" rx="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    Vos réponses restent sur cet appareil et sont enregistrées au fur et à mesure : vous pouvez fermer la page et
    reprendre plus tard.
  </p>
</header>
