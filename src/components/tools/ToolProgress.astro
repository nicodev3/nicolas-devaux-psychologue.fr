---
/**
 * Barre de progression collante des questionnaires.
 *
 * Au-delà du pourcentage, elle sert de poste de pilotage : nombre de questions
 * restantes, saut direct vers la prochaine sans réponse (indispensable sur les
 * tests longs), rappel de l'échelle et confirmation de sauvegarde.
 */
interface Props {
  total: number;
  /** Échelle de réponse, rappelée dans un dépliant pour éviter de remonter aux consignes. */
  scale?: readonly (readonly [number, string])[];
}

const { total, scale } = Astro.props;
---

<div class="sticky top-14 z-20 mb-6 md:top-18" x-show="!submitted">
  <div
    class="rounded-xl border border-border-subtle bg-surface-page/95 px-3 py-2.5 shadow-[0_10px_30px_-24px_rgb(66_79_78_/_0.5)] backdrop-blur-sm sm:px-4 sm:py-3"
  >
    <div class="mb-1.5 flex items-center justify-between gap-3">
      <span class="flex items-center gap-2 font-ui text-xs font-medium text-ink-tertiary">
        Progression
        <span
          x-show="savedFlash"
          x-cloak
          x-transition.opacity
          class="inline-flex items-center gap-1 rounded-full bg-secondary px-2 py-0.5 text-[11px] font-medium text-ink-secondary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3 w-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12 5 5L20 7"></path>
          </svg>
          Enregistré
        </span>
      </span>
      <span class="font-ui text-xs font-medium tabular-nums text-ink-secondary">
        <span x-text="answeredCount"></span>/{total}
      </span>
    </div>

    <div
      class="h-2 w-full overflow-hidden rounded-full bg-surface-muted"
      role="progressbar"
      aria-label="Progression du questionnaire"
      aria-valuemin="0"
      aria-valuemax={total}
      :aria-valuenow="answeredCount"
      :aria-valuetext="`${answeredCount} réponse${answeredCount > 1 ? 's' : ''} sur ${total}`"
    >
      <div class="h-2 rounded-full bg-brand transition-all duration-300" :style="`width: ${progress}%`"></div>
    </div>

    <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2" x-show="answeredCount > 0" x-cloak>
      <p class="mb-0 text-xs text-ink-tertiary" x-text="remainingLabel"></p>
      <button
        type="button"
        x-show="remainingCount > 0"
        @click="goToUnanswered()"
        aria-label="Aller à la prochaine question sans réponse"
        class="inline-flex min-h-8 items-center gap-1 rounded-md px-2 py-1 font-ui text-xs font-medium text-brand transition-colors hover:bg-secondary"
      >
        Aller à la suivante
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M6 13l6 6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        x-show="remainingCount === 0"
        x-cloak
        @click="submit()"
        class="inline-flex min-h-8 items-center gap-1 rounded-md bg-brand px-3 py-1 font-ui text-xs font-medium text-brand-ink-on transition-colors hover:bg-brand-hover"
      >
        Voir mes résultats
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>

    {
      scale && (
        <details class="group mt-2 border-t border-border-subtle pt-2">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 font-ui text-xs font-medium text-ink-tertiary transition-colors hover:text-ink-secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 transition-transform group-open:rotate-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 5 7 7-7 7" />
            </svg>
            Rappel de l'échelle
          </summary>
          <ul class="mt-2 grid list-none grid-cols-1 gap-1 p-0 text-xs text-ink-secondary sm:grid-cols-2 lg:grid-cols-3">
            {scale.map(([value, label]) => (
              <li class="m-0 flex items-start gap-2">
                <span class="font-ui flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-border-strong bg-surface-raised text-[11px] font-medium text-tertiary">
                  {value}
                </span>
                <span class="leading-snug">{label}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</div>
