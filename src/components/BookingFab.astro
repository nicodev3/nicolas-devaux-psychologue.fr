---
import DoctolibBookingLink from "./DoctolibBookingLink.astro";
import { BOOKING_FOR_EXISTING_PATIENTS_ONLY } from "../data/consultation-availability";
---

{/*
  Bouton flottant : visible une fois le hero (#hero) sorti de l'écran, et masqué tant
  qu'un autre bouton de réservation est à l'écran (#horaires-tarifs, ou tout élément
  marqué data-booking-fab-hide) ainsi qu'au-dessus du pied de page.
*/}
{!BOOKING_FOR_EXISTING_PATIENTS_ONLY && (<Fragment>
<script is:inline>
  document.addEventListener("alpine:init", () => {
    Alpine.data("bookingFab", () => ({
      heroOut: false,
      blockers: new Set(),
      visible: false,
      sync() {
        this.visible = this.heroOut && this.blockers.size === 0;
      },
      init() {
        const inView = (el) => {
          const r = el.getBoundingClientRect();
          return r.top < window.innerHeight && r.bottom > 0;
        };

        const hero = document.getElementById("hero");
        if (hero) {
          this.heroOut = !inView(hero);
          new IntersectionObserver(([e]) => {
            this.heroOut = !e.isIntersecting;
            this.sync();
          }).observe(hero);
        } else {
          this.heroOut = true;
        }

        const blockers = document.querySelectorAll(
          "#horaires-tarifs, [data-booking-fab-hide], footer",
        );
        blockers.forEach((el) => {
          if (inView(el)) this.blockers.add(el);
          new IntersectionObserver(([e]) => {
            if (e.isIntersecting) this.blockers.add(el);
            else this.blockers.delete(el);
            this.sync();
          }).observe(el);
        });

        this.sync();
      },
    }));
  });
</script>

<div
  class="fixed end-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 md:end-6 md:bottom-6"
  x-data="bookingFab()"
  x-show="visible"
  x-transition.opacity.duration.200ms
  x-cloak
>
  <DoctolibBookingLink location="FAB" size="lg" class="shadow-lg">
    Prendre rendez-vous
  </DoctolibBookingLink>
</div>
</Fragment>)}
