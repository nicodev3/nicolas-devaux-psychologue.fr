---
import { CONSULTATION_AVAILABILITY } from "../data/consultation-availability";

interface Props {
  /** Permet de prévisualiser le message sans modifier le réglage du site. */
  active?: boolean;
  /** Format court adapté à un lien ou à un bouton. */
  compact?: boolean;
  class?: string;
}

const {
  active = CONSULTATION_AVAILABILITY.isFull,
  compact = false,
  class: className,
} = Astro.props;
---

{active && (
  <span
    class:list={[
      "font-ui inline-flex max-w-full flex-col gap-1 rounded-lg border border-s-4 border-warning-border bg-warning-surface text-start text-warning-ink whitespace-normal [overflow-wrap:anywhere]",
      compact ? "px-3 py-2 text-xs" : "px-4 py-3 text-sm",
      className,
    ]}
    data-consultation-availability
  >
    <strong class="font-semibold">{CONSULTATION_AVAILABILITY.title}</strong>
    <span>{CONSULTATION_AVAILABILITY.message}</span>
  </span>
)}
