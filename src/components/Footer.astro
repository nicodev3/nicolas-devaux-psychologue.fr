---
import DoctolibBookingLink from "./DoctolibBookingLink.astro";
import {
  ADELI_NUMBER,
  LEGAL_ENTITY_NAME,
  RPPS_NUMBER,
  SIRET_NUMBER,
} from "../consts";

const siteMap = [
  {
    title: "Pages principales",
    links: [
      { href: "/", label: "Accueil" },
      { href: "/psychologue-sceaux/", label: "Psychologue à Sceaux" },
      { href: "/therapie-couple/", label: "Thérapie de couple" },
      { href: "/psychologue-en-ligne/", label: "Psychologue en ligne" },
      { href: "/meditation-pleine-conscience-sceaux/", label: "Groupes de pleine conscience" },
      { href: "/consulter/", label: "Consulter" },
      { href: "/tarifs/", label: "Tarifs" },
      { href: "/nicolas-devaux-psychologue/", label: "À propos" },
      { href: "/psychotherapie/", label: "Approches thérapeutiques" },
      { href: "/ressources/", label: "Ressources par thème" },
      { href: "/blog/", label: "Articles" },
    ],
  },
  {
    title: "Approches thérapeutiques",
    links: [
      { href: "/therapie-mosaic/", label: "Thérapie MOSAIC" },
      {
        href: "/therapie-cognitive-et-comportementale/",
        label: "Thérapie cognitive et comportementale",
      },
      { href: "/tcc-troisieme-vague/", label: "TCC de 3e vague" },
      { href: "/therapie-acceptation-et-engagement/", label: "ACT (TCC de 3e vague)" },
      { href: "/therapie-pleine-conscience/", label: "MBCT/MBSR (TCC de 3e vague)" },
      { href: "/therapie-fondee-compassion/", label: "Thérapie fondée sur la compassion" },
    ],
  },
  {
    title: "Informations",
    links: [
      { href: "/mentions-legales/", label: "Mentions légales" },
      { href: "/mon-soutien-psy/", label: "Mon Soutien Psy (informations)" },
    ],
  },
];
---

<footer class="border-none bg-surface-footer text-ink-secondary">
  <div class="mx-auto max-w-[1140px] px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-12 md:flex-row">
      <div class="max-w-sm shrink-0">
        <h2 class="font-display mb-4 text-[1.75rem] leading-snug text-ink-primary">Nicolas Devaux</h2>
        <p class="typo-body mb-6 opacity-80">
          Psychologue clinicien diplômé de l'Université Paris Cité. Accompagnement psychothérapeutique
          pour adultes, adolescents et couples.
        </p>
        <p class="text-sm italic opacity-80">
          Les informations échangées dans le cadre des consultations sont protégées par le secret
          professionnel.
        </p>
      </div>

      <div class="grid min-w-0 flex-1 grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
        {
          siteMap.map((group) => (
            <div class="min-w-0">
              <h3 class="footer-section-label mb-4">{group.title}</h3>
              <ul class="space-y-2 font-ui text-xs tracking-wide">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="opacity-80 transition-all hover:opacity-100 hover:text-ink-primary"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex justify-center border-t border-ink-primary/10 pt-10">
      <DoctolibBookingLink
        location="Footer"
        size="lg"
        class="inline-flex w-full max-w-sm items-center justify-center normal-case md:w-auto md:min-w-[240px]"
      >
        Prendre rendez-vous
      </DoctolibBookingLink>
    </div>
  </div>

  <div
    class="mx-auto max-w-[1140px] border-t border-ink-primary/10 px-4 py-8 text-center sm:px-6 md:text-left lg:px-8"
  >
    <p class="font-ui text-xs tracking-wide opacity-60">
      © {new Date().getFullYear()} {LEGAL_ENTITY_NAME} · Psychologue à Sceaux. Tous droits réservés.
      SIRET : {SIRET_NUMBER} · RPPS : {RPPS_NUMBER}
      {ADELI_NUMBER ? ` · ADELI : ${ADELI_NUMBER}` : ""}
    </p>
  </div>
</footer>
