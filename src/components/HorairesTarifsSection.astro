---
import SectionHeading from "./SectionHeading.astro";
import {
  OPENING_SATURDAY_HOURS,
  OPENING_SATURDAY_LABEL,
  OPENING_WEEKDAYS_HOURS,
  OPENING_WEEKDAYS_LABEL,
} from "../consts";

const tariffs = [
  { label: "Consultation individuelle", duration: "45 min", price: "80€" },
  { label: "Consultation MOSAIC", duration: "1 h", price: "90€" },
  { label: "Consultation de couple", duration: "1 h", price: "110€" },
  { label: "Participation aux groupes", duration: "8 séances", price: "30€ / séance" },
] as const;
---

<section
  id="horaires-tarifs"
  class="py-16 md:py-[7.5rem]"
  aria-labelledby="horaires-tarifs-heading"
>
  <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-16">
    <div>
      <SectionHeading class="mb-8" eyebrow="04 — Pratique" id="horaires-tarifs-heading">
        <a href="/tarifs/" class="text-inherit no-underline transition-opacity hover:opacity-70">
          Horaires et tarifs
        </a>
      </SectionHeading>

      <div class="space-y-6">
        <div class="rounded-lg bg-surface-muted p-6">
          <h3
            class="mb-4 font-ui text-sm font-bold uppercase tracking-wider text-ink-primary"
            id="horaires-heading"
          >
            Horaires d'ouverture
          </h3>
          <ul class="space-y-2 text-ink-secondary" role="list">
            <li class="flex justify-between gap-4">
              <span>{OPENING_WEEKDAYS_LABEL}</span>
              <span class="tabular-nums">{OPENING_WEEKDAYS_HOURS}</span>
            </li>
            <li class="flex justify-between gap-4">
              <span>{OPENING_SATURDAY_LABEL}</span>
              <span class="tabular-nums">{OPENING_SATURDAY_HOURS}</span>
            </li>
            <li class="flex justify-between gap-4">
              <span>Autres jours</span>
              <span>Fermé</span>
            </li>
          </ul>
        </div>
        <p class="font-ui text-xs italic text-ink-secondary">
          Paiement : Chèques, espèces et virement bancaire. Cartes bancaires non acceptées.
        </p>
      </div>
    </div>

    <div class="space-y-4" aria-labelledby="tarifs-heading">
      <h3
        id="tarifs-heading"
        class="mb-4 font-ui text-sm font-bold uppercase tracking-wider text-ink-primary"
      >
        Tarifs des consultations
      </h3>
      {
        tariffs.map(({ label, duration, price }) => (
          <div class="flex items-center justify-between gap-4 border-b border-border-strong p-6 transition-colors hover:bg-surface-muted">
            <div>
              <h4 class="typo-body-lg mb-0 font-bold text-ink-primary">{label}</h4>
              <span class="text-sm text-ink-secondary">{duration}</span>
            </div>
            <span class="font-display text-[1.75rem] leading-none text-ink-primary tabular-nums">
              {price}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
