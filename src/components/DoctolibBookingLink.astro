---
import DoctolibMark from "./DoctolibMark.astro";
import { buttonClasses, type ButtonSize } from "./ui/button";
import { DOCTOLIB_BOOKING_URL } from "../consts";
import { CONSULTATION_AVAILABILITY } from "../data/consultation-availability";

interface Props {
  /** Emplacement pour le tracking Umami. */
  location: string;
  size?: ButtonSize;
  fullWidth?: boolean;
  class?: string;
  /** Libellé accessible si le texte visible diffère. */
  ariaLabel?: string;
  /** Taille du glyphe D. */
  markSize?: "sm" | "md" | "lg";
}

const {
  location,
  size = "md",
  fullWidth = false,
  class: className,
  ariaLabel = "Prendre rendez-vous sur Doctolib",
  markSize = size === "sm" ? "sm" : size === "lg" ? "lg" : "md",
} = Astro.props;

/* Cabinet complet : bouton secondaire réservé aux patients déjà suivis (libellé commun à tout le site). */
const { isFull } = CONSULTATION_AVAILABILITY;
const fullLabel = size === "sm" ? CONSULTATION_AVAILABILITY.bookingLabelShort : CONSULTATION_AVAILABILITY.bookingLabel;
---

<a
  href={DOCTOLIB_BOOKING_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={buttonClasses({
    variant: isFull ? "secondary" : "primary",
    size,
    fullWidth,
    className,
  })}
  aria-label={isFull ? "Patients déjà suivis : prendre rendez-vous sur Doctolib" : ariaLabel}
  data-track-doctolib
  data-track-location={location}
  data-booking-audience={isFull ? "suivis" : undefined}
>
  <span class="inline-flex items-center justify-center gap-2">
    <DoctolibMark size={markSize} />
    <span>{isFull ? fullLabel : <slot>Prendre rendez-vous</slot>}</span>
  </span>
</a>
