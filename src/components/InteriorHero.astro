---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultHero from "../assets/cabinet-1.webp";
import { applyFrenchTypography } from "../utils/frenchTypography.js";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  heroCredit?: string;
  heroCreditUrl?: string;
}

const {
  title,
  description,
  eyebrow = "Cabinet de psychologie",
  heroImage,
  heroAlt = "Cabinet de psychologie à Sceaux — espace de consultation",
  heroCredit,
  heroCreditUrl,
} = Astro.props;

const image = heroImage ?? defaultHero;
const formattedTitle = applyFrenchTypography(title);
const formattedEyebrow = applyFrenchTypography(eyebrow);
---

<section
  class="relative flex min-h-[420px] items-end overflow-hidden md:min-h-[560px] lg:min-h-[640px]"
  aria-labelledby="interior-hero-heading"
>
  <div class="absolute inset-0 z-0">
    <Picture
      src={image}
      alt={heroAlt}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[480, 720, 1080, 1440, 1920]}
      sizes="100vw"
      quality={80}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-brand/15" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-linear-to-t from-surface-page via-surface-page/55 to-transparent"
      aria-hidden="true"
    ></div>
    {
      heroCredit && (
        <p class="absolute right-3 bottom-3 z-10 rounded bg-black/55 px-2 py-1 font-ui text-[0.65rem] text-white/90">
          {heroCreditUrl ? (
            <a href={heroCreditUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
              {heroCredit}
            </a>
          ) : (
            heroCredit
          )}
        </p>
      )
    }
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1140px] px-4 pb-12 pt-28 sm:px-6 md:pb-16 md:pt-36 lg:px-8 lg:pb-20">
    <div class="max-w-2xl rounded-2xl bg-surface-page/95 p-5 shadow-sm backdrop-blur-sm sm:p-6">
      <p class="typo-eyebrow mb-4 tracking-[0.2em] text-ink-primary md:mb-5">
        {formattedEyebrow}
      </p>
      <h1
        id="interior-hero-heading"
        class="font-display hero-heading-display mb-6 text-pretty text-ink-primary md:mb-8"
      >
        {formattedTitle}
      </h1>
      {
        description && (
          <p class="typo-body-lg mb-0 max-w-lg text-pretty text-ink-secondary">
            {description}
          </p>
        )
      }
    </div>
  </div>
</section>
