---
import { TOOLS } from "../data/tools";

/**
 * Maillage interne entre les pages `/outils/*` : chaque questionnaire renvoie
 * vers ses voisins, pour qu'aucun outil ne dépende du seul lien de l'index.
 */
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
const siblings = TOOLS.filter((tool) => tool.href !== currentPath);
---

{
  siblings.length > 0 && (
    <nav
      class="mt-16 border-t border-border-subtle pt-10 md:mt-20 md:pt-12"
      aria-labelledby="related-tools-heading"
    >
      <p class="typo-eyebrow mb-3 md:mb-4">Autres outils</p>
      <h2
        id="related-tools-heading"
        class="font-display typo-h3 mb-6 text-pretty text-ink-primary md:mb-8"
      >
        Poursuivre avec un autre questionnaire
      </h2>
      <ul class="grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2">
        {siblings.map((tool) => (
          <li class="m-0">
            <a
              href={tool.href}
              class="block h-full rounded-lg border border-border-subtle px-4 py-3 font-ui text-sm text-ink-secondary no-underline transition-colors hover:border-brand/35 hover:text-ink-primary"
            >
              {tool.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
