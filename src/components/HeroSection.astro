---
import { Picture } from "astro:assets";
import portrait from "../assets/nicolas_devaux.jpg";
import DoctolibBookingLink from "./DoctolibBookingLink.astro";
import { buttonClasses } from "./ui/button";
---

<section
  id="hero"
  class="w-full py-16 md:py-[7.5rem]"
  aria-labelledby="hero-heading"
>
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-16">
    <div class="order-2 md:order-1 md:col-span-7">
      <h1 id="hero-heading" class="font-display hero-heading-display mb-6 text-ink-primary md:mb-8">
        Nicolas Devaux
      </h1>
      <p class="font-display mb-6 text-xl text-ink-primary md:text-[1.75rem] md:leading-snug">
        Psychologue clinicien · cabinet et visio
      </p>
      <p class="typo-body-lg mb-10 max-w-xl text-ink-secondary md:mb-12">
        Psychologue diplômé de l'Université Paris Cité, j'accompagne les adultes, adolescents et couples
        dans un cadre bienveillant et confidentiel — en présentiel au cabinet ou en visioconférence. Je
        propose des thérapies cognitives et comportementales (TCC), de la thérapie MOSAIC pour les
        traumatismes, et de la thérapie de couple. Mon approche intégrative s'adapte à votre situation, à
        votre rythme et à vos objectifs.
      </p>
      <div class="flex flex-wrap gap-4">
        <DoctolibBookingLink
          location="Hero"
          size="lg"
          class="shadow-(--shadow-button-primary)"
        >
          Prendre rendez-vous
        </DoctolibBookingLink>
        <a
          href="/psychologue-sceaux/"
          class={buttonClasses({ variant: "secondary", size: "lg" })}
        >
          Accès au cabinet →
        </a>
      </div>
    </div>

    <div class="relative order-1 md:order-2 md:col-span-5">
      <div class="aspect-4/5 overflow-hidden rounded-xl shadow-2xl">
        <Picture
          src={portrait}
          alt="Nicolas Devaux - Psychologue clinicien à Sceaux"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[400, 560, 720]}
          sizes="(max-width: 767px) 100vw, 40vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover grayscale-[20%] transition-all duration-700 hover:grayscale-0"
        />
      </div>
    </div>
  </div>
</section>
