---
import { Picture } from "astro:assets";
import portrait from "../assets/nicolas-devaux.webp";
import DoctolibBookingLink from "./DoctolibBookingLink.astro";
import { buttonClasses } from "./ui/button";
import { CONSULTATION_AVAILABILITY } from "../data/consultation-availability";

const { isFull } = CONSULTATION_AVAILABILITY;
---

<section
  id="hero"
  class="w-full py-16 md:py-[7.5rem]"
  aria-labelledby="hero-heading"
>
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-16">
    <div class="min-w-0 md:col-span-7">
      <h1 id="hero-heading" class="font-display hero-heading-display mb-6 text-ink-primary md:mb-8">
        Nicolas Devaux
      </h1>
      <p class="font-display mb-6 text-xl text-ink-primary md:text-[1.75rem] md:leading-snug">
        Psychologue clinicien · cabinet et visio
      </p>
      <p class="typo-body-lg mb-8 max-w-xl text-ink-secondary md:mb-10">
        Psychologue diplômé de l'Université Paris Cité, j'accompagne les adultes, adolescents et couples
        dans un cadre bienveillant et confidentiel — en présentiel au cabinet ou en visioconférence. Je
        propose des thérapies cognitives et comportementales (TCC), de la thérapie MOSAIC pour les
        traumatismes, et de la thérapie de couple.<span class="hidden sm:inline">
        Mon approche intégrative s'adapte à votre situation, à votre rythme et à vos objectifs.</span>
      </p>
      {/* Cabinet complet : l'état est annoncé ici, juste au-dessus du seul bouton qu'il concerne. */}
      {isFull && (
        <p class="font-ui mb-5 max-w-xl text-sm leading-relaxed text-ink-secondary" data-consultation-availability>
          <strong class="font-semibold text-warning-ink">{CONSULTATION_AVAILABILITY.title}.</strong>
          {" "}{CONSULTATION_AVAILABILITY.message} {CONSULTATION_AVAILABILITY.followUpNote}
        </p>
      )}
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <DoctolibBookingLink
          location="Hero"
          size="lg"
          class={isFull ? "w-full sm:w-auto" : "shadow-(--shadow-button-primary)"}
        >
          Prendre rendez-vous
        </DoctolibBookingLink>
        <a
          href="/psychologue-sceaux/"
          class={buttonClasses({ variant: "link", className: "inline-flex min-h-11 items-center text-sm" })}
        >
          Psychologue à Sceaux — accès au cabinet →
        </a>
      </div>
    </div>

    <div class="min-w-0 md:col-span-5">
      <Picture
        src={portrait}
        alt="Nicolas Devaux - Psychologue clinicien à Sceaux"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[400, 560, 720]}
        sizes="(max-width: 767px) 100vw, 40vw"
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: "block overflow-hidden rounded-xl shadow-2xl" }}
        class="block h-auto w-full"
      />
    </div>
  </div>
</section>
