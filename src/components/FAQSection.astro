---
import SectionHeading from "./SectionHeading.astro";
import { OPENING_HOURS_TEXT } from "../consts";

const faqs = [
  {
    id: "faq-1",
    question: "Comment prendre rendez-vous ?",
    answerHtml: `Vous pouvez prendre rendez-vous facilement via <strong>Doctolib</strong> en cliquant sur le bouton «&nbsp;Prendre rendez-vous&nbsp;». Les consultations se déroulent uniquement sur rendez-vous, ${OPENING_HOURS_TEXT}.`,
  },
  {
    id: "faq-2",
    question: "Quelle est la durée d'une séance ?",
    answerHtml:
      "Les consultations individuelles et les consultations vidéo durent <strong>45 minutes</strong>. Les consultations de couple et les séances MOSAIC durent <strong>1 heure</strong>.",
  },
  {
    id: "faq-3",
    question: "Les séances sont-elles remboursées ?",
    answerHtml:
      'Les consultations de psychologie ne sont pas remboursées par la Sécurité Sociale, mais de nombreuses mutuelles proposent une prise en charge partielle ou totale. Renseignez-vous auprès de la vôtre. Le dispositif <a href="/mon-soutien-psy/" class="text-link">Mon Soutien Psy</a> n\'accepte plus de nouveaux patients au cabinet.',
  },
  {
    id: "faq-4",
    question: "Combien de séances sont nécessaires ?",
    answerHtml:
      "La durée varie selon vos besoins et objectifs. Certaines difficultés peuvent être résolues en quelques séances, tandis que d'autres nécessitent un accompagnement plus long. Nous évaluons régulièrement l'évolution et ajustons ensemble le rythme des consultations.",
  },
  {
    id: "faq-5",
    question: "Proposez-vous des consultations en ligne ?",
    answerHtml:
      'Oui, je propose des consultations vidéo pour les personnes qui ne peuvent pas se déplacer ou préfèrent ce format. Les séances en ligne respectent la même confidentialité qu\'au cabinet. Voir la page <a href="/psychologue-en-ligne/" class="text-link">psychologue en ligne</a>.',
  },
] as const;
---

<section
  id="faq"
  class="relative left-1/2 w-screen -translate-x-1/2 bg-surface-accent py-16 md:py-[7.5rem]"
  aria-labelledby="faq-heading"
  x-data="{ openId: 'faq-1' }"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center md:mb-16">
      <SectionHeading
        class="mb-0 [&_.section-heading-group]:items-center"
        eyebrow="03 — FAQ"
        title="Questions fréquentes"
        id="faq-heading"
      />
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <article
            class="overflow-hidden rounded-lg bg-surface-raised p-6 shadow-sm transition-all duration-300"
          >
            <button
              type="button"
              class="flex w-full cursor-pointer items-center justify-between gap-4 text-left"
              @click={`openId = openId === '${faq.id}' ? null : '${faq.id}'`}
              :aria-expanded={`openId === '${faq.id}'`}
              aria-controls={`${faq.id}-content`}
              id={`${faq.id}-toggle`}
            >
              <h3 class="font-display text-lg text-ink-primary">{faq.question}</h3>
              <svg
                class="h-5 w-5 shrink-0 text-ink-tertiary transition-transform duration-300"
                :class={`openId === '${faq.id}' && 'rotate-180'`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>
            <div
              id={`${faq.id}-content`}
              role="region"
              aria-labelledby={`${faq.id}-toggle`}
              x-show={`openId === '${faq.id}'`}
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            >
              <div class="pt-4">
                <p class="typo-body mb-0 text-ink-secondary" set:html={faq.answerHtml} />
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="/consulter/"
        class="border-b border-ink-primary font-ui text-sm font-medium tracking-wide text-ink-primary transition-opacity hover:opacity-70"
      >
        Voir modalités →
      </a>
    </div>
  </div>
</section>
