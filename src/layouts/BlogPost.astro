---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import BlogSchema from "../components/BlogSchema.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ArticleScrollProgress from "../components/ArticleScrollProgress.astro";
import ArticleShareLinks from "../components/ArticleShareLinks.astro";
import ArticleRelatedPosts from "../components/ArticleRelatedPosts.astro";
import ArticleCta from "../components/ArticleCta.astro";
import InteriorHero from "../components/InteriorHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import "../styles/global.css";
import "../styles/content.css";
import { formatFrenchDate, toDateTime } from "../utils/formatDate";
import { applyFrenchTypography } from "../utils/frenchTypography.js";
import type { BlogTag } from "../consts";
import { BLOG_TAG_LABELS } from "../consts";

type Props = Omit<CollectionEntry<"blog">["data"], "tags" | "published"> & {
  tags?: BlogTag[];
  blogPost?: boolean;
  showDate?: boolean;
  readingTimeMinutes?: number;
  hasFaq?: boolean;
  eyebrow?: string;
  wideContent?: boolean;
  compactHero?: boolean;
  heroAlt?: string;
  heroCredit?: string;
  heroCreditUrl?: string;
  relatedPosts?: CollectionEntry<"blog">[];
};

const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  blogPost = false,
  showDate = true,
  readingTimeMinutes,
  hasFaq = false,
  eyebrow,
  wideContent = false,
  compactHero = false,
  heroAlt,
  heroCredit,
  heroCreditUrl,
  relatedPosts = [],
} = Astro.props;

const formattedTitle = applyFrenchTypography(title);

const slug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const isBlogArticle = blogPost && Astro.url.pathname.startsWith("/blog/");
const readingTimeLabel = readingTimeMinutes ? `${readingTimeMinutes} min de lecture` : "Lecture";
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const TAG_KICKERS: Record<string, string> = {
  sommeil: "Psychologie & sommeil",
  act: "ACT · Flexibilité psychologique",
  compassion: "Compassion · Relation à soi",
  etudiants: "Études · Attention",
  therapies: "Psychothérapie · Approches",
  "pleine-conscience": "Pleine conscience · Pratiques",
  couple: "Thérapie de couple",
  consulter: "Psychologie · Repères",
  outils: "Santé mentale · Outils",
};
const articleKicker =
  tags.length > 0 ? (TAG_KICKERS[tags[0]] ?? "Santé mentale · Article") : "Santé mentale · Article";

const interiorEyebrow = eyebrow ?? "Cabinet de psychologie";
const resolvedHeroImage = heroImage as ImageMetadata | undefined;
---

<html lang="fr">
  <head>
    <BaseHead title={seoTitle ?? title} description={description} />
    {blogPost && (
      <BlogSchema
        title={title}
        description={description}
        pubDate={pubDate}
        updatedDate={updatedDate}
        slug={slug}
        heroImage={heroImage}
      />
    )}
  </head>

  <body class="bg-surface-page">
    <ArticleScrollProgress enabled={isBlogArticle} />
    <Header />
    {
      isBlogArticle ? (
        <main>
          {/* Header article — centré, container 1140 */}
          <header class="mx-auto max-w-[1140px] px-4 pt-12 text-center sm:px-6 md:pt-20 lg:px-8">
            <a
              href="/blog/"
              class="group mb-10 inline-flex items-center gap-2 font-ui text-sm font-medium tracking-widest text-ink-secondary uppercase transition-colors hover:text-ink-primary md:mb-12"
            >
              <span aria-hidden="true">←</span>
              <span>Retour au blog</span>
            </a>

            <div class="mx-auto max-w-3xl">
              {tags.length > 0 ? (
                <div class="mb-6 flex flex-wrap justify-center gap-2">
                  {tags.slice(0, 1).map((tag) => (
                    <a
                      href={`/blog/?tag=${tag}`}
                      class="typo-eyebrow tracking-[0.2em] text-ink-tertiary transition-colors hover:text-ink-primary"
                      data-tag-link={tag}
                    >
                      {articleKicker}
                    </a>
                  ))}
                </div>
              ) : (
                <p class="typo-eyebrow mb-6 tracking-[0.2em] text-ink-tertiary">{articleKicker}</p>
              )}

              <h1 class="font-display hero-heading-display mb-8 text-pretty text-ink-primary">
                {formattedTitle}
              </h1>

              <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-ui text-sm text-ink-secondary">
                {showDate && (
                  <time datetime={toDateTime(pubDate)}>{formatFrenchDate(pubDate)}</time>
                )}
                {showDate && readingTimeMinutes && (
                  <span class="size-1 rounded-full bg-ink-tertiary" aria-hidden="true" />
                )}
                {readingTimeMinutes && <span>{readingTimeLabel}</span>}
                {updatedDate && (
                  <span class="w-full text-ink-tertiary md:w-auto">
                    Mis à jour le{" "}
                    <time datetime={toDateTime(updatedDate)}>{formatFrenchDate(updatedDate)}</time>
                  </span>
                )}
              </div>

              {hasFaq && (
                <a
                  href="#faq"
                  class="mt-6 inline-flex items-center gap-2 font-ui text-sm font-semibold text-brand transition-colors hover:text-brand-hover"
                >
                  Aller aux questions fréquentes
                  <span aria-hidden="true">↓</span>
                </a>
              )}
            </div>
          </header>

          {/* Image featured — 1140, ratio 21/9 */}
          {heroImage && (
            <div class="mx-auto max-w-[1140px] px-4 py-10 sm:px-6 md:py-16 lg:px-8">
              <figure class="aspect-[21/9] w-full overflow-hidden rounded-sm bg-surface-footer">
                <Picture
                  src={heroImage}
                  alt={title}
                  width={heroImage.width}
                  height={heroImage.height}
                  pictureAttributes={{ class: "block h-full w-full" }}
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  widths={[720, 1080, 1440]}
                  sizes="(max-width: 1140px) 100vw, 1140px"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  class="h-full w-full object-cover"
                />
              </figure>
            </div>
          )}

          {/* Corps — max-w-2xl centré */}
          <article class="mx-auto max-w-2xl px-4 pb-16 sm:px-6 md:pb-24">
            {description && (
              <p class="article-lead mb-10 border-l-2 border-info-border pl-6 text-lg italic leading-relaxed text-ink-primary md:mb-12 md:text-[1.125rem]">
                {description}
              </p>
            )}

            <div class="c-prose article-prose article-prose--stitch">
              <slot />
            </div>

            <div class="mt-14 flex flex-col items-center justify-between gap-6 border-t border-border-subtle pt-8 md:mt-16 md:flex-row">
              {tags.length > 0 && (
                <div class="flex flex-wrap justify-center gap-2 md:justify-start">
                  {tags.map((tag) => (
                    <a
                      href={`/blog/?tag=${tag}`}
                      class="rounded-full bg-surface-muted px-4 py-1 font-ui text-xs font-semibold tracking-wide text-ink-secondary uppercase transition-colors hover:bg-border-subtle hover:text-ink-primary"
                      data-tag-link={tag}
                    >
                      {BLOG_TAG_LABELS[tag]}
                    </a>
                  ))}
                </div>
              )}
              <ArticleShareLinks title={title} url={articleUrl} />
            </div>
          </article>

          <ArticleRelatedPosts posts={relatedPosts} />
          <ArticleCta />
        </main>
      ) : (
        <>
          {!compactHero && (
            <InteriorHero
              title={title}
              description={description}
              eyebrow={interiorEyebrow}
              heroImage={resolvedHeroImage ?? undefined}
              heroAlt={heroAlt}
              heroCredit={heroCredit}
              heroCreditUrl={heroCreditUrl}
            />
          )}
          <main class:list={["page-shell", !compactHero && "page-shell--flush-top"]}>
            <Breadcrumb title={title} />
            {compactHero && (
              <header class="mb-10 md:mb-12">
                <p class="typo-eyebrow mb-4">{interiorEyebrow}</p>
                <h1 class="font-display typo-h1 mb-6 text-pretty text-ink-primary md:mb-8">
                  {formattedTitle}
                </h1>
                {description && (
                  <p class="typo-body-lg max-w-2xl text-pretty text-ink-secondary">{description}</p>
                )}
              </header>
            )}
            <article class="w-full">
              <div
                class:list={[
                  "c-wysiwig",
                  !wideContent && "interior-prose",
                  compactHero && "border-t border-border-subtle pt-10 md:pt-12",
                ]}
              >
                <slot />
              </div>
            </article>
          </main>
        </>
      )
    }
    <Footer />
  </body>
</html>
