---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Footer from "../components/Footer.astro";
import InteriorHero from "../components/InteriorHero.astro";
import RelatedTools from "../components/RelatedTools.astro";
import ToolAnalytics from "../components/ToolAnalytics.astro";
import ToolFormRuntime from "../components/tools/ToolFormRuntime.astro";
import "../styles/global.css";
import type { ImageMetadata } from "astro";

interface Props {
  /** Titre affiché — sert de H1 dans le hero. */
  title: string;
  /** Titre SEO (balise <title>) quand il doit différer du H1. */
  seoTitle?: string;
  description: string;
  eyebrow?: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  /** Masque le maillage inter-outils (inutile sur l'index, qui les liste déjà tous). */
  showRelatedTools?: boolean;
}

const {
  title,
  seoTitle,
  description,
  eyebrow = "Outils",
  heroImage,
  heroAlt,
  showRelatedTools = true,
} = Astro.props;
---

<html lang="fr">
  <head>
    <BaseHead title={seoTitle ?? title} description={description} />
    <ToolFormRuntime />
  </head>
  <body class="tool-page bg-surface-page">
    <Header />
    <div class="no-print">
      <InteriorHero
        title={title}
        description={description}
        eyebrow={eyebrow}
        heroImage={heroImage}
        heroAlt={heroAlt}
      />
    </div>
    <main class="page-shell page-shell--flush-top">
      <Breadcrumb title={title} />
      <slot />
      {showRelatedTools && <RelatedTools />}
    </main>
    <Footer />
    <ToolAnalytics />
  </body>
</html>
